# Shared password for the whole app (required in production; without it the app is locked).
APP_PASSWORD=
# Optional: secret for the login cookie (defaults to a hash of APP_PASSWORD).
APP_SESSION_SECRET=

# Cloud storage in Supabase (optional; without both, projects stay in each browser).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Claude key for AI plan recognition and the assistant.
ANTHROPIC_API_KEY=
# Optional limits.
AI_DAILY_LIMIT=300
LOGIN_RATE_LIMIT=8
